+
+
+def check(cv, cx, cy, u, t, c1, c2):
+    cv.circle(cx, cy, 46 * u, fill=lin(cx, cy - 46 * u, cx, cy + 46 * u, [(0, "#3fe08a"), (1, "#0f7a45")]), shadow=(0, 6 * u, 8 * u, "#000a"))
+    p = skia.Path()
+    p.moveTo(cx - 22 * u, cy + 2 * u)
+    p.lineTo(cx - 6 * u, cy + 18 * u)
