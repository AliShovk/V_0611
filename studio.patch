+    cv.poly(_poly([(-26, 52), (26, 52), (14, 40), (-14, 40)], cx, cy, u), fill="#b8820f")
+    bx0, by0, bx1, by1 = cx - 46 * u * ca, cy - 36 * u - 46 * u * sa, cx + 46 * u * ca, cy - 36 * u + 46 * u * sa
+    cv.line(bx0, by0, bx1, by1, "#ffe9a0", 6 * u)
